# Copy to `.env.local` in this folder (Next.js loads it automatically).

# --- Supabase (autosave + optional file storage fallback) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (resume links). In production use https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WBT logo (frontend, email, PDF). Default: Supabase hosted logo.
# WBT_LOGO_URL=https://dtgcctkekahzjtvepowr.supabase.co/storage/v1/object/public/images/unnamed.png

# --- Email: SMTP (preferred when all SMTP_* vars below are set) ---
# If SMTP_HOST + SMTP_USER + SMTP_PASSWORD are set, resume + save-progress emails use SMTP.
# Otherwise the app uses Resend (RESEND_API_KEY).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Dev only: set to "false" if your SMTP uses a self-signed cert (not for production).
# SMTP_TLS_REJECT_UNAUTHORIZED=

# --- Email: Resend (fallback when SMTP is not fully configured) ---
RESEND_API_KEY=
RESEND_FROM=

# --- Bunny.net Storage (file uploads) ---
# When ALL of the following are set, POST /api/upload sends files to Bunny Storage
# and returns a CDN URL. Otherwise uploads use Supabase Storage (requires bucket setup).
#
# Storage zone name (Bunny dashboard → Storage → your zone).
BUNNY_STORAGE_ZONE=
# Storage zone "FTP & API password" (AccessKey for HTTP API).
BUNNY_STORAGE_API_KEY=
# Primary region code: de | uk | ny | la | sg | se | br | jh | syd (default: de).
BUNNY_STORAGE_REGION=de
# Pull zone hostname + optional path prefix, no trailing slash, e.g. https://myzone.b-cdn.net
BUNNY_PUBLIC_CDN_BASE=
# Uncomment only if Bunny gives a custom API host:
# BUNNY_STORAGE_HOST=uk.storage.bunnycdn.com
