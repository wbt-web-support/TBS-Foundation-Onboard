# Copy to `.env.local` in this folder (Next.js loads it automatically).

# --- Supabase (autosave + optional file storage fallback) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=

# --- Bunny.net Storage (file uploads) ---
# When ALL of the following are set, POST /api/upload sends files to Bunny Storage
# and returns a CDN URL. Otherwise uploads use Supabase Storage (requires bucket setup).
#
# Storage zone name (Bunny dashboard → Storage → your zone).
BUNNY_STORAGE_ZONE=
# Storage zone "FTP & API password" (AccessKey for HTTP API).
BUNNY_STORAGE_API_KEY=
# Primary region code: de | uk | ny | la | sg | se | br | jh | syd (default: de).
BUNNY_STORAGE_REGION=de
# Pull zone hostname + optional path prefix, no trailing slash, e.g. https://myzone.b-cdn.net
BUNNY_PUBLIC_CDN_BASE=
# Uncomment only if Bunny gives a custom API host:
# BUNNY_STORAGE_HOST=uk.storage.bunnycdn.com
